{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    ":separateMajorReleases"
  ],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group all base-image bumps in a single PR per week.",
      "matchManagers": ["dockerfile"],
      "groupName": "docker base images"
    },
    {
      "description": "Auto-merge every update. Homelab policy: a bad bump is a revert, and the running container still needs a manual Apply, so nothing changes silently.",
      "automerge": true
    },
    {
      "description": "Keep majors visible in the dependency dashboard even though they merge themselves.",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-upgrade-review"]
    },
    {
      "description": "Group GitHub Actions workflow updates separately so they don't pollute image-bump PRs.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true
  }
}
